# Privy credentials (required)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# JWT secret for session tokens (required, min 32 chars)
# Generate: openssl rand -base64 32
JWT_SECRET=

# Server port (optional, default: 3001)
PORT=3001

# Public URL (optional, for Origin header in production)
# If not set, defaults to http://localhost:3001
PUBLIC_URL=

# Allowed CORS origins (optional, comma-separated)
# Leave empty for CLI-only access (no browser CORS needed)
ALLOWED_ORIGINS=

# Client IP source for rate limiting (optional, default: false)
#   false       use the TCP peer address and ignore all proxy headers
#   cloudflare  use CF-Connecting-IP (only if the origin is reachable solely via Cloudflare)
#   <N>         N trusted proxy hops in front of the server; X-Forwarded-For is read from the right
# Behind a single load balancer that appends the client address to X-Forwarded-For, use 1.
TRUST_PROXY=false

# AVNU Paymaster (optional, for gasless sponsored transactions)
# Used to sponsor transactions for users
AVNU_API_KEY=
AVNU_PAYMASTER_URL=https://starknet.paymaster.avnu.fi/v1
