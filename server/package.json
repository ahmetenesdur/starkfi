{
	"name": "starkfi-server",
	"version": "0.1.0",
	"description": "Backend for starkfi CLI — Privy auth, Starknet wallet management, signing",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/src/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@hono/node-server": "^1.19.14",
		"@hono/zod-validator": "^0.7.6",
		"@privy-io/node": "^0.10.1",
		"hono": "^4.12.21",
		"jose": "^6.2.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^25.9.1",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"tsx": "^4.22.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.4",
		"vitest": "^5.1.0"
	}
}
